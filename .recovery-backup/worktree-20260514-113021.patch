+}
+
+pid_from_file() {
+  local pid_file="$1"
+  [[ -f "$pid_file" ]] && cat "$pid_file" || true
+}
+
+process_command() {
+  local pid="$1"
+  ps -p "$pid" -o command= 2>/dev/null || true
+}
+
+process_cwd() {
+  local pid="$1"
+  local line
+  lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | while IFS= read -r line; do
+    case "$line" in
+      n*) printf '%s\n' "${line#n}"; break ;;
+    esac
+  done
+}
+
+service_owns_pid() {
+  local name="$1"
+  local pid="$2"
+  local command
+  local cwd
+
+  command="$(process_command "$pid")"
+  cwd="$(process_cwd "$pid")"
+
+  case "$name" in
